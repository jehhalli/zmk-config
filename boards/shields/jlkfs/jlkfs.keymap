#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define L_DEFAULT 0
#define L_NUM     1
#define L_NAV     2
#define L_BT      3

//------------------------------------------------------------------------------
// Defaults
//------------------------------------------------------------------------------

&lt {
  tapping-term-ms = <150>;
  flavor = "hold-preferred";
  quick-tap-ms = <300>;
};

&mt {
  quick-tap-ms = <300>;
};

/ {

//------------------------------------------------------------------------------
// Behaviors
//------------------------------------------------------------------------------

  behaviors {

    mtb: balanced_mod_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <250>;
      quick-tap-ms = <300>;
      require-prior-idle-ms = <125>;
      bindings = <&kp>, <&kp>;
      display-name = "Balanced-Mod-Tap";
    };
  };

  //----------------------------------------------------------------------------
  // Combos
  //----------------------------------------------------------------------------

  combos {
    compatible = "zmk,combos";

    combo_bootloader_l {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <3 4>;
      bindings = <&bootloader>;
    };

    combo_bootloader_r {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <5 6>;
      bindings = <&bootloader>;
    };

    combo_delete {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <8 9>;
      bindings = <&kp DEL>;
    };

    combo_bt_layer {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <0 1>;
      bindings = <&mo L_BT >;
    };
  };


  //----------------------------------------------------------------------------
  // Keymap
  //----------------------------------------------------------------------------

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp GRAVE &none &none &none &none
        &none &none &none &none &kp BSPC

        &kp LBKT &kp SQT &kp COMMA &kp DOT &kp P &kp Y &none
        &none &kp F &kp G &kp C &kp R &kp L &kp RBKT

        &kp FSLH &kp A &mtb LALT O &mtb LCTRL E &mtb LGUI U &kp I &none
        &none &kp D &mtb LGUI H &mtb LCTRL T &mtb LALT N &kp S &kp MINUS

        &kp BSLH &kp SEMI &kp Q &kp J &kp K &kp X &none
        &none &kp B &kp M &kp W &kp V &kp Z &kp EQUAL

        &lt L_NAV DOWN &lt L_NAV UP &mt LSHIFT ESC &lt L_NAV TAB
        &lt L_NUM ENTER &kp SPACE &lt L_NAV LEFT &lt L_NAV RIGHT
      >;
    };

    num_layer {
      bindings = <
        &kp TILDE &none &none &none &none
        &none &none &none &none &none

        &kp LBRC &none &trans &trans &none &none &none
        &none &none &none &none &none &none &none

        &kp QMARK &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &none
        &none &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none

        &kp PIPE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &none
        &none &kp CARET &kp AMPS &kp STAR &kp LPAR &kp RPAR &none

        &none &none &none &caps_word
        &none &none &none &none
      >;
    };

    nav_layer {
      bindings = <
        &none &none &none &none &none
        &none &none &none &none &none

        &none &kp LC(LG(Q)) &none &none &none &none &none
        &none &none &none &none &none &none &none

        &none &none &kp LC(UP) &kp LC(LS(TAB)) &kp LC(TAB) &none &none
        &none &kp LC(LS(SPACE)) &kp LC(LS(LEFT)) &kp LC(LS(DOWN)) &kp LC(LS(UP)) &kp LC(LS(RIGHT)) &none

        &none &none &none &none &none &none &none
        &none &none &none &none &none &none &none

        &kp PGDN &kp PGUP &trans &trans
        &trans &trans &kp HOME &kp END
      >;
    };

    bluetooth_layer {
      bindings = <
        &none &none &none &none &none
        &none &none &none &none &none

        &none &none &none &none &none &none &none
        &none &none &bt BT_SEL 0 &bt BT_SEL 1 &none &none &none

        &none &none &none &none &none &none &none
        &none &none &out OUT_BLE &out OUT_USB &none &none &bt BT_CLR_ALL

        &none &none &none &none &none &none &none
        &none &none &bt BT_DISC 0 &bt BT_DISC 1 &none &none &none

        &none &none &none &none
        &none &none &none &none
      >;
    };

  };
};
