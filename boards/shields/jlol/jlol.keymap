#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define L_DEFAULT 0
#define L_NAV     1
#define L_SHORT   2
#define L_BT      3

//------------------------------------------------------------------------------
// Defaults
//------------------------------------------------------------------------------

&lt {
  tapping-term-ms = <150>;
  flavor = "hold-preferred";
  quick-tap-ms = <300>;
};

&mt {
  quick-tap-ms = <300>;
};

/ {

//------------------------------------------------------------------------------
// Behaviors
//------------------------------------------------------------------------------

  behaviors {

    mtb: balanced_mod_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <250>;
      quick-tap-ms = <300>;
      require-prior-idle-ms = <125>;
      bindings = <&kp>, <&kp>;
      display-name = "Balanced-Mod-Tap";
    };
  };

  //----------------------------------------------------------------------------
  // Combos
  //----------------------------------------------------------------------------

  combos {
    compatible = "zmk,combos";

    combo_delete {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <10 11>;
      bindings = <&kp DEL>;
    };

    combo_bootloader {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <48 49 54 55>;
      bindings = <&bootloader>;
    };

    combo_globe {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <36 37>;
      bindings = <&kp GLOBE>;
    };

    combo_bt_layer {
      timeout-ms = <50>;
      layers = <L_DEFAULT>;
      key-positions = <0 1>;
      bindings = <&mo L_BT >;
    };
  };

  //----------------------------------------------------------------------------
  // Keymap
  //----------------------------------------------------------------------------

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
        &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp BSPC

        &kp LBKT &kp SQT &kp COMMA &kp DOT &kp P &kp Y
        &kp F &kp G &kp C &kp R &kp L &kp RBKT

        &kp FSLH &kp A &mtb LALT O &mtb LCTRL E &mtb LGUI U &kp I
        &kp D &mtb LGUI H &mtb LCTRL T &mtb LALT N &kp S &kp MINUS

        &kp BSLH &kp SEMI &kp Q &kp J &kp K &kp X
        &kp B &kp M &kp W &kp V &kp Z &kp EQUAL

        &lt L_NAV DOWN &lt L_NAV UP &mt LSHIFT ESC &lt L_SHORT TAB
        &lt L_NAV ENTER &kp SPACE &lt L_NAV LEFT &lt L_NAV RIGHT
      >;
    };

    nav_layer {
      bindings = <
        &kp TILDE &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
        &none &none &none &none &none &none

        &kp LBRC &none &none &kp PGUP &none &none
        &none &none &kp UP &none &none &none

        &kp QMARK &none &kp HOME &kp PGDN &kp END &none
        &none &kp LEFT &kp DOWN &kp RIGHT &none &none 

        &kp PIPE &kp COLON &none &none &none &none
        &none &none &none &none &none &none

        &kp PGDN &kp PGUP &none &caps_word
        &none &none &kp HOME &kp END
      >;
    };

    shortcut_layer {
      bindings = <
        &none &none &none &none &none &none
        &kp K_MUTE &kp K_VOL_DN &kp K_VOL_UP &none &none &none

        &none &kp LC(LG(Q)) &none &none &none &none
        &none &none &none &none &none &none

        &none &none &kp LC(UP) &kp LC(LS(TAB)) &kp LC(TAB) &none
        &kp LC(LS(SPACE)) &kp LC(LS(LEFT)) &kp LC(LS(DOWN)) &kp LC(LS(UP)) &kp LC(LS(RIGHT)) &none 

        &none &none &none &none &none &none
        &none &none &none &none &none &none

        &none &none &none &none
        &none &none &none &none
      >;
    };

    bluetooth_layer {
      bindings = <
        &none &none &none &none &none &none
        &none &none &none &none &none &none

        &none &none &none &none &none &none
        &none &bt BT_SEL 0 &bt BT_SEL 1 &none &none &none

        &none &none &none &none &none &none
        &none &out OUT_BLE &out OUT_USB &none &none &bt BT_CLR_ALL

        &none &none &none &none &none &none
        &none &bt BT_DISC 0 &bt BT_DISC 1 &none &none &none

        &none &none &none &none
        &none &none &none &none
      >;
    };
  };
};
