#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define L_DEFAULT 0
#define L_NUM     1
#define L_SYM     2
#define L_NAV     3
#define L_BT      4

//------------------------------------------------------------------------------
// Defaults
//------------------------------------------------------------------------------

&lt {
  tapping-term-ms = <150>;
  flavor = "hold-preferred";
  quick-tap-ms = <300>;
};

&mt {
  quick-tap-ms = <300>;
};

/ {

//------------------------------------------------------------------------------
// Behaviors
//------------------------------------------------------------------------------

  behaviors {

    mtb: balanced_mod_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <250>;
      quick-tap-ms = <300>;
      require-prior-idle-ms = <125>;
      bindings = <&kp>, <&kp>;
      display-name = "Balanced-Mod-Tap";
    };

    ltb: balanced_layer_tap {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <250>;
      quick-tap-ms = <300>;
      require-prior-idle-ms = <250>;
      bindings = <&mo>, <&kp>;
      display-name = "Balanced-Layer-Tap";
    };

  };

  //----------------------------------------------------------------------------
  // Combos
  //----------------------------------------------------------------------------

  combos {
    compatible = "zmk,combos";

    combo_bootloader_l {
      key-positions = <0 1 2 3>;
      bindings = <&bootloader>;
    };

    combo_bootloader_r {
      key-positions = <6 7 8 9>;
      bindings = <&bootloader>;
    };

    combo_escape {
      timeout-ms = <100>;
      key-positions = <1 2>;
      bindings = <&kp ESC>;
    };

    combo_bt_layer {
      key-positions = <30 33>;
      bindings = <&mo L_BT>;
    };
  };


  //----------------------------------------------------------------------------
  // Keymap
  //----------------------------------------------------------------------------

  keymap {
    compatible = "zmk,keymap";

    default_layer {
      bindings = <
        &kp SQT &kp COMMA &kp DOT &kp P &kp Y
        &kp F &kp G &kp C &kp R &kp L

        &kp A &mtb LALT O &mtb LCTRL E &mtb LGUI U &kp I
        &kp D &mtb LGUI H &mtb LCTRL T &mtb LALT N &kp S

        &kp SEMI &kp Q &kp J &kp K &kp X
        &kp B &kp M &kp W &kp V &kp Z

        &mt LSHIFT BSPC &lt L_SYM TAB
        &lt L_NUM ENTER &ltb L_NAV SPACE
      >;
    };

    num_layer {
      bindings = <
        &none &trans &trans &none &none
        &none &kp LPAR &kp RPAR &none &none

        &kp N1 &kp N2 &kp N3 &kp N4 &kp N5
        &kp N6 &kp N7 &kp N8 &kp N9 &kp N0

        &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT
        &kp CARET &kp AMPS &kp STAR &none &none

        &none &caps_word
        &none &none
      >;
    };

    sym_layer {
      bindings = <
        &kp LC(LG(Q)) &none &none &none &none
        &none &kp LBKT &kp RBKT &kp LBRC &kp RBRC

        &none &kp LC(UP) &kp LC(LS(TAB)) &kp LC(TAB) &kp ESC
        &kp GRAVE &kp MINUS &kp UNDER &kp EQUAL &kp PLUS

        &kp LC(LS(LEFT)) &kp LC(LS(DOWN)) &kp LC(LS(UP)) &kp LC(LS(RIGHT)) &kp LC(LS(SPACE))
        &kp TILDE &kp FSLH &kp BSLH &kp QMARK &kp PIPE

        &kp DEL &none
        &caps_word &none
      >;
    };

    nav_layer {
      bindings = <
        &none &none &none &none &none
        &none &none &none &none &none

        &none &kp HOME &kp PGUP &kp END &none
        &none &kp LEFT &kp UP &kp RIGHT &none

        &none &none &kp PGDN &none &none
        &none &none &kp DOWN &none &none

        &none &none
        &none &none
      >;
    };

    bluetooth_layer {
      bindings = <
        &none &none &none &none &none
        &none &bt BT_SEL 0 &bt BT_SEL 1 &none &none

        &none &none &none &none &none
        &none &out OUT_BLE &out OUT_USB &none &bt BT_CLR_ALL

        &none &none &none &none &none
        &none &bt BT_DISC 0 &bt BT_DISC 1 &none &none

        &none &none
        &none &none
      >;
    };

  };
};
